# --- LLM: Amazon Bedrock (preferito) ---
BEDROCK_AWS_ACCESS_KEY_ID=your_aws_access_key_id
BEDROCK_AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
BEDROCK_AWS_REGION=eu-west-1
BEDROCK_INFERENCE_PREFIX=eu
# Modello di default: Opus 4.6 EU. Override con: eu.anthropic.claude-sonnet-4-6
BEDROCK_MODEL=eu.anthropic.claude-opus-4-6-v1

# --- LLM: Anthropic API diretta (fallback se Bedrock non configurato; usato anche
#     dalle chiamate vision di content_service.py, che non passano da Bedrock) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Servizi esterni ---
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# --- Immagini (Unsplash gratuito; Getty a pagamento se configurato) ---
GETTY_API_KEY=your_getty_api_key_here
GETTY_ACCESS_TOKEN=your_getty_access_token_here
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# --- Password applicativa (lascia vuoto in locale per disabilitare il gate) ---
APP_PASSWORD=

# --- CORS (comma-separated origins) ---
ALLOWED_ORIGINS=http://localhost:3000

# --- Soglia di grounding (0-1): sotto questa quota di 4-gram condivisi con
#     il PDF fonte, una variante viene marcata "da verificare" nella UI ---
GROUNDING_THRESHOLD=0.5

# --- Percorso del DB SQLite (default: backend/data/scolastica.db) ---
# SCOLASTICA_DB_PATH=./data/scolastica.db

# --- Test/CI: salta le chiamate LLM reali, usa un piano finto ---
# FAKE_LLM=1
