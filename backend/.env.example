# --- LLM: Amazon Bedrock (preferito, stesse credenziali di arcai) ---
BEDROCK_AWS_ACCESS_KEY_ID=your_aws_access_key_id
BEDROCK_AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
BEDROCK_AWS_REGION=eu-west-1
BEDROCK_INFERENCE_PREFIX=eu
# Modello di default: Opus 4.6 EU. Override con: eu.anthropic.claude-sonnet-4-6
BEDROCK_MODEL=eu.anthropic.claude-opus-4-6-v1

# --- LLM: Anthropic API diretta (fallback se Bedrock non configurato) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Servizi esterni ---
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
GAMMA_API_KEY=your_gamma_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# --- Immagini ---
GETTY_API_KEY=your_getty_api_key_here
GETTY_ACCESS_TOKEN=your_getty_access_token_here
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# --- Database ---
SUPABASE_URL=https://wicigewxkuemigfvozsu.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# --- CORS (comma-separated origins) ---
ALLOWED_ORIGINS=http://localhost:3000
